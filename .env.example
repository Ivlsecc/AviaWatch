# Скопируйте в .env и заполните

# Telegram: токен от @BotFather и ваш Telegram ID (узнать: @userinfobot)
BOT_TOKEN=
ADMIN_TG_IDS=[123456789]

# Travelpayouts: https://www.travelpayouts.com → Профиль → API-токен
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Локально без Docker — SQLite. В docker-compose переопределяется на Postgres.
DATABASE_URL=sqlite+aiosqlite:///./aviawatch.db
# Пусто — кэш в памяти процесса
REDIS_URL=

# Глобальный прокси для всех источников, например socks5://user:pass@host:1080
HTTP_PROXY=

POSTGRES_PASSWORD=aviawatch

# Прокси до Telegram (если он заблокирован). Пусто — системный прокси/VPN, если есть
TELEGRAM_PROXY=

# Веб-админка: логин/пароль администратора и секрет для токенов (любая длинная случайная строка)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
API_PORT=8000
